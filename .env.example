# Copie este arquivo para ".env.local" e preencha os valores.
# Nunca compartilhe o arquivo ".env.local" com outras pessoas.

# Usuário e senha do painel de administração (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Chave usada para proteger a sessão de login do admin (qualquer frase longa e aleatória)
ADMIN_SECRET=troque-esta-frase-secreta-bem-longa-e-unica

# ID do Google AdSense (formato: ca-pub-XXXXXXXXXXXXXXXX). Deixe em branco se ainda não tiver.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Chave PIX de doação (pode ser trocada depois direto pelo painel /admin/config)
NEXT_PUBLIC_PIX_KEY=88981228898

# --- Banco de dados (Vercel Postgres) ---
# Não preencha estas variáveis manualmente. Depois de criar o banco de dados
# "Postgres" no painel da Vercel e conectá-lo a este projeto, rode o comando
# abaixo no terminal para preenchê-las automaticamente:
#   vercel env pull .env.local
POSTGRES_URL=

# --- Armazenamento de fotos e vídeos (Vercel Blob) ---
# Também preenchido automaticamente pelo comando "vercel env pull .env.local",
# depois de criar o "Blob Store" no painel da Vercel.
BLOB_READ_WRITE_TOKEN=
